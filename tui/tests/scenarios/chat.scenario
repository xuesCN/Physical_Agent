{
  "name": "chat",
  "cases": [
    {
      "name": "plain chat command streams into transcript and keeps actions visible",
      "useSse": true,
      "initialState": "chatReady",
      "initialConfig": "default",
      "events": {
        "behavior": "idle",
        "items": [
          { "type": "hello", "payload": { "executor": { "mode": "embedded", "status": "active", "lease": { "active": true } } } },
          { "type": "state", "state": "chatReady" }
        ]
      },
      "responses": {
        "sendChatStream": [
          {
            "events": [
              { "type": "delta", "payload": { "delta": "Hello" } },
              { "type": "delta", "payload": { "delta": " from agent" } },
              { "type": "done", "payload": { "reply": "## Current Workspace\n\n**Robot state**\n- `arm_1` is currently **idle**.\n\n**Visible objects**\n1. **red_block**\n   - Type: block\n   - Color: red", "state": { "ready": true, "chat_messages": 3 } } }
            ],
            "state": "chatAfterReply"
          }
        ]
      },
      "initialExpectOutput": ["Physical Agent TUI", "SSE", "Executor: embedded (active)"],
      "steps": [
        {
          "input": "hello robot",
          "covers": ["<text chat>"],
          "expectOutput": ["> hello robot", "⏺ Current Workspace", "Robot state", "• arm_1 is currently idle.", "1. red_block", "◦ Type: block"],
          "rejectOutput": ["## Current Workspace", "**Robot state**", "`arm_1`", "**red_block**"],
          "expectCalls": { "sendChatStream": 1 },
          "expectState": { "chat.messages.2.content": "## Current Workspace\n\n**Robot state**\n- `arm_1` is currently **idle**.\n\n**Visible objects**\n1. **red_block**\n   - Type: block\n   - Color: red" }
        },
        {
          "input": "/view actions",
          "covers": ["/view actions"],
          "expectOutput": ["actions", "act_001", "approval required"],
          "expectCalls": { "health": 2, "state": 2, "config": 2 }
        }
      ]
    }
  ]
}
