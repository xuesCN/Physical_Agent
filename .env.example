# OpenAI-compatible LLM configuration
#
# Volcengine Ark / Doubao example. Do not commit real API keys.
GPT_URL=https://ark.cn-beijing.volces.com/api/v3
GPT_KEY=<ark key>
GPT_MODEL=doubao-seed-2.1-pro

# If your Ark resource uses an inference endpoint id, GPT_MODEL may be ep-xxxx.
#
# Optional:
# GPT_API_MODE=chat_completions
# GPT_API_MODE=responses
