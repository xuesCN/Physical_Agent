{
  "name": "basic",
  "cases": [
    {
      "name": "local help, polling status, refresh, and quit",
      "columns": 100,
      "useSse": false,
      "initialState": "ready",
      "initialConfig": "default",
      "initialExpectOutput": ["███╗   ███╗", "Physical Agent TUI", "polling", "Ready."],
      "initialRejectOutput": ["MOCE · PHYSICAL AGENT"],
      "steps": [
        {
          "input": "/help",
          "covers": ["/help"],
          "expectOutput": ["Commands:", "/task <text>", "/quit"]
        },
        {
          "input": "/view status",
          "covers": ["/view status", "polling fallback"],
          "expectOutput": ["status", "backend: sqlite", "connection: connected via polling", "robots: 1"],
          "expectCalls": { "health": 2, "state": 2, "config": 2 }
        },
        {
          "input": "/view chat",
          "covers": ["/view chat"],
          "expectOutput": ["View: chat", "No chat yet. Type a message or /help."]
        },
        {
          "input": "/refresh",
          "covers": ["/refresh"],
          "expectOutput": ["Snapshot refreshed.", "LLM connected"],
          "expectCalls": { "health": 3, "state": 3, "config": 3, "llmSettings": 2, "testLlmSettings": 2 }
        },
        {
          "input": "/quit",
          "covers": ["/quit"],
          "expectCalls": { "submitTask": 0, "approveAction": 0, "rejectAction": 0, "resetWorkspace": 0 }
        }
      ]
    },
    {
      "name": "compact layout at 48 columns",
      "columns": 48,
      "useSse": false,
      "initialState": "ready",
      "initialConfig": "default",
      "initialExpectOutput": ["MOCE · PHYSICAL AGENT", "Physical Agent TUI", "message or /help"],
      "initialRejectOutput": ["███╗   ███╗"],
      "initialMaxLineWidth": 48,
      "steps": [
        {
          "input": "/view status",
          "expectOutput": ["status", "backend: sqlite"],
          "maxLineWidth": 48
        },
        {
          "input": "/view chat",
          "expectOutput": ["View: chat", "message or /help"],
          "maxLineWidth": 48
        }
      ]
    },
    {
      "name": "compact fallback when stdout width is unknown",
      "columns": null,
      "useSse": false,
      "initialState": "ready",
      "initialConfig": "default",
      "initialExpectOutput": ["MOCE · PHYSICAL AGENT", "Physical Agent TUI", "message or /help"],
      "initialRejectOutput": ["███╗   ███╗"],
      "steps": []
    }
  ]
}
